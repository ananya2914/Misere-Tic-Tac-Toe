<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp"
        android:gravity="center_horizontal">

        <!-- Title -->
        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tic-Tac-Tooe"
            android:textSize="28sp"
            android:textStyle="bold"
            android:paddingTop="8dp"
            android:paddingBottom="8dp" />

        <!-- Status -->
        <TextView
            android:id="@+id/statusText1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your turn (X)"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#2E7D32"
            android:paddingBottom="12dp" />

        <!-- Board container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="12dp"
            android:background="@android:color/white"
            android:elevation="2dp">

            <!-- ANDROIDX GRIDLAYOUT: note the app: namespace below -->
            <!-- Square board container -->
            <com.example.bluetooth.SquareGridLayout

                android:id="@+id/gridLayout1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                app:rowCount="3"
                app:columnCount="3"
                android:background="#2F3C73"
                app:useDefaultMargins="true"
                app:alignmentMode="alignMargins">

                <!-- 9 equally weighted cells -->
                <!-- Row 0 -->
                <ImageButton
                    android:id="@+id/cell_00"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_row="0"
                    app:layout_column="0"
                    app:layout_rowWeight="1"
                    app:layout_columnWeight="1"
                    android:background="#D9D9D9"
                    android:scaleType="centerInside"
                    android:adjustViewBounds="true"
                    android:contentDescription="Cell 0,0" />

                <ImageButton
                    android:id="@+id/cell_01"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_row="0"
                    app:layout_column="1"
                    app:layout_rowWeight="1"
                    app:layout_columnWeight="1"
                    android:background="#D9D9D9"
                    android:scaleType="centerInside"
                    android:adjustViewBounds="true"
                    android:contentDescription="Cell 0,1" />

                <ImageButton
                    android:id="@+id/cell_02"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_row="0"
                    app:layout_column="2"
                    app:layout_rowWeight="1"
                    app:layout_columnWeight="1"
                    android:background="#D9D9D9"
                    android:scaleType="centerInside"
                    android:adjustViewBounds="true"
                    android:contentDescription="Cell 0,2" />

                <!-- Row 1 -->
                <ImageButton
                    android:id="@+id/cell_10"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_row="1"
                    app:layout_column="0"
                    app:layout_rowWeight="1"
                    app:layout_columnWeight="1"
                    android:background="#D9D9D9"
                    android:scaleType="centerInside"
                    android:adjustViewBounds="true"
                    android:contentDescription="Cell 1,0" />

                <ImageButton
                    android:id="@+id/cell_11"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_row="1"
                    app:layout_column="1"
                    app:layout_rowWeight="1"
                    app:layout_columnWeight="1"
                    android:background="#D9D9D9"
                    android:scaleType="centerInside"
                    android:adjustViewBounds="true"
                    android:contentDescription="Cell 1,1" />

                <ImageButton
                    android:id="@+id/cell_12"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_row="1"
                    app:layout_column="2"
                    app:layout_rowWeight="1"
                    app:layout_columnWeight="1"
                    android:background="#D9D9D9"
                    android:scaleType="centerInside"
                    android:adjustViewBounds="true"
                    android:contentDescription="Cell 1,2" />

                <!-- Row 2 -->
                <ImageButton
                    android:id="@+id/cell_20"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_row="2"
                    app:layout_column="0"
                    app:layout_rowWeight="1"
                    app:layout_columnWeight="1"
                    android:background="#D9D9D9"
                    android:scaleType="centerInside"
                    android:adjustViewBounds="true"
                    android:contentDescription="Cell 2,0" />

                <ImageButton
                    android:id="@+id/cell_21"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_row="2"
                    app:layout_column="1"
                    app:layout_rowWeight="1"
                    app:layout_columnWeight="1"
                    android:background="#D9D9D9"
                    android:scaleType="centerInside"
                    android:adjustViewBounds="true"
                    android:contentDescription="Cell 2,1" />

                <ImageButton
                    android:id="@+id/cell_22"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_row="2"
                    app:layout_column="2"
                    app:layout_rowWeight="1"
                    app:layout_columnWeight="1"
                    android:background="#D9D9D9"
                    android:scaleType="centerInside"
                    android:adjustViewBounds="true"
                    android:contentDescription="Cell 2,2" />

            </com.example.bluetooth.SquareGridLayout>


        </LinearLayout>

        <!-- Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="12dp">

            <Button
                android:id="@+id/resetGame"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="RESET GAME"
                android:textAllCaps="true"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:background="@drawable/btn_primary_bg"
                android:paddingTop="12dp"
                android:paddingBottom="12dp" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="10dp" />

            <Button
                android:id="@+id/settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SETTINGS"
                android:textAllCaps="true"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:background="@drawable/btn_secondary_bg"
                android:paddingTop="12dp"
                android:paddingBottom="12dp" />
        </LinearLayout>

        <!-- Settings (hidden by default) -->
        <LinearLayout
            android:id="@+id/settingsPage"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:paddingTop="16dp">

            <Spinner
                android:id="@+id/spinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="12dp">

                <Button
                    android:id="@+id/submit"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="APPLY"
                    android:textAllCaps="true"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:background="@drawable/btn_primary_bg"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp" />

                <Space
                    android:layout_width="12dp"
                    android:layout_height="1dp" />

                <Button
                    android:id="@+id/leaveSettings"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="BACK"
                    android:textAllCaps="true"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:background="@drawable/btn_secondary_bg"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
