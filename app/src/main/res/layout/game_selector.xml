<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Full-bleed background -->
    <ImageView
        android:id="@+id/bgImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/home_screen"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <!-- Foreground content (no overlay) -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="24dp">

        <!-- Top title/subtitle -->
        <LinearLayout
            android:id="@+id/titleBlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="8dp">

            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tic-Tac-Toe"
                android:textStyle="bold"
                android:textSize="24sp"
                android:textColor="@android:color/white" />

            <TextView
                android:id="@+id/subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" Take your best shot for three in a row!"
                android:textSize="14sp"
                android:textColor="@android:color/white"
                android:alpha="0.9"
                android:paddingTop="6dp" />
        </LinearLayout>

        <!-- Bottom buttons -->
        <LinearLayout
            android:id="@+id/buttonPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginTop="250dp"
            android:orientation="vertical"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingBottom="12dp">

            <Button
                android:id="@+id/online_game"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="START ONLINE GAME"
                android:textAllCaps="true"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:background="@drawable/btn_primary_bg"
                android:paddingTop="14dp"
                android:paddingBottom="14dp" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="12dp" />

            <Button
                android:id="@+id/offline_game"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="START OFFLINE GAME"
                android:textAllCaps="true"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:background="@drawable/btn_secondary_bg"
                android:paddingTop="14dp"
                android:paddingBottom="14dp" />
        </LinearLayout>

    </RelativeLayout>
</FrameLayout>
